# ─── Bosch Home Connect ───────────────────────────────────────────────────────
# Create a developer account at https://developer.home-connect.com/
# Then register an application to get these credentials.
HOMECONNECT_CLIENT_ID=your_client_id_here
HOMECONNECT_CLIENT_SECRET=your_client_secret_here

# The redirect URI you registered in the Home Connect developer portal.
# For local dev use http://localhost:3000/auth/callback
# For Railway use https://your-app.railway.app/auth/callback
HOMECONNECT_REDIRECT_URI=http://localhost:3000/auth/callback

# The haMid (Home Appliance ID) of your Bosch dishwasher.
# Found in the Home Connect app → Appliances → your dishwasher → Settings
HOMECONNECT_DISHWASHER_HAIM=BOSCH-XXXXXXXXXXXXXXXXXX

# ─── Family members (comma-separated, in rotation order) ─────────────────────
# These are the names shown in notifications and the app.
FAMILY_KIDS=Kid1,Kid2,Kid3,Kid4

# Parent contact (receives shame notifications and escalation alerts)
PARENT_NAME=Mom/Dad

# ─── Expo Push Notifications ─────────────────────────────────────────────────
# No key needed — Expo handles FCM for you. Push tokens are registered by the app.

# ─── App settings ─────────────────────────────────────────────────────────────
PORT=3000

# Secret used to authenticate parent-only API calls (pick any long random string)
PARENT_SECRET=change_this_to_a_long_random_secret

# Escalation intervals in minutes
ESCALATION_REMINDER_MINUTES=30
ESCALATION_SHAME_MINUTES=120
ESCALATION_LOCK_MINUTES=180
